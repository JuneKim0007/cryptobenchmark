# Copy to .env (git-ignored). Prefer perfrepair.yaml (perfrepair.example.yaml) for PERFREPAIR_* settings.
# A bad value here warns and uses the default, except PERFREPAIR_AGENT and PERFREPAIR_AUTH, which stop the command.
# Precedence: CLI flag > a role section in perfrepair.yaml > environment > the gateway's block in perfrepair.yaml > this file
# > the role's code default > the general code default (docs/settings.md).

# claude:  the claude gateway; PERFREPAIR_AUTH picks how it is reached
# dry-run: no model; every stage runs with stand-in answers
PERFREPAIR_AGENT=claude
# subscription: your Claude subscription, through the logged-in `claude` CLI (no API key)
# api:          the Anthropic API (needs ANTHROPIC_API_KEY and `pip install -e .[api]`)
PERFREPAIR_AUTH=subscription
PERFREPAIR_MODEL=claude-opus-5-5
# Unset, assign runs at low and the others at medium; set, it applies to every role without its own section.
# PERFREPAIR_EFFORT=medium

# auth api only; never passed to the CLI of auth subscription. Not allowed in perfrepair.yaml.
ANTHROPIC_API_KEY=

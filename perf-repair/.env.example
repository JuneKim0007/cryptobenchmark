# Copy to .env (git-ignored). Prefer perfrepair.yaml (perfrepair.example.yaml) for PERFREPAIR_* settings.
# Precedence: CLI flag > environment > perfrepair.yaml > this file > code default (docs/settings.md).
# PERFREPAIR_EFFORT sets agent.effort only: per-role efforts (the supervisor's high) are not lowered by it.

# claude-code: your Claude subscription, through the logged-in `claude` CLI (no API key)
# claude:      the Anthropic API (needs ANTHROPIC_API_KEY and `pip install -e .[api]`)
# dry-run:     no model; every stage runs with stand-in answers
PERFREPAIR_AGENT=claude-code
PERFREPAIR_MODEL=claude-opus-5-5
PERFREPAIR_EFFORT=medium

# claude backend only; never passed to the claude-code backend's CLI. Not allowed in perfrepair.yaml.
ANTHROPIC_API_KEY=

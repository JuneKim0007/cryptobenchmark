# Dry-pass host session (scripts/energy_session.py): fastest rail poll plus this app's atrace energy markers.
buffers { size_kb: 16384 fill_policy: RING_BUFFER }
data_sources { config { name: "android.power" android_power_config { battery_poll_ms: 100 collect_power_rails: true } } }
data_sources { config { name: "linux.ftrace" ftrace_config { atrace_apps: "io.github.junekim0007.cryptobench" } } }
data_sources { config { name: "linux.process_stats" process_stats_config { scan_all_processes_on_start: true } } }
write_into_file: true
file_write_period_ms: 2500
flush_period_ms: 5000
duration_ms: 3600000
